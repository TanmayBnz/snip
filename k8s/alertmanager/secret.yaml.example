apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-config
stringData:
  alertmanager.yml: |
    route:
      receiver: discord
      group_wait: 10s
      group_interval: 5m
      repeat_interval: 3h
    receivers:
      - name: discord
        slack_configs:
          - api_url: "https://discord.com/api/webhooks/REPLACE_ME/slack"
            channel: "#alerts"
            send_resolved: true
            title: '{{ .CommonAnnotations.summary }}'
            text: '{{ .CommonAnnotations.description }}'
